# Copy to .env

# Optional: if present, RainAlert uses OpenWeatherMap for live weather.
# If blank, the project automatically uses Open-Meteo (no API key required).
OPENWEATHERMAP_API_KEY=

# Optional Hugging Face token for the existing Safety Agent LLM path.
HF_TOKEN=
HF_LLM_MODEL=HuggingFaceH4/zephyr-7b-beta

# React/Vite frontend origin used by FastAPI CORS.
FRONTEND_ORIGIN=http://localhost:5173
